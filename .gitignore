# streaming demo writes annotated videos next to its (small, tracked) montages
images/stream/*.mp4

# live webcam captures contain footage of the user - keep local, do not commit
images/stream/live_c920*

# visualizer outputs: regenerated by tracking/visualize/*.py on demand, so they should not
# creep back into the tree every time one is run (three were deleted in the 2026-09-01 cleanup)
tracking/visualize/aligned_masks.png
tracking/visualize/debug_integrate.png
tracking/visualize/integrated_image_comparison.png

# downloaded detector weights: regeneratable, keep out of the repo
data/*.pt

# TensorRT build artifacts. NEVER commit these: an engine is compiled for one GPU compute
# capability, one TRT version and one CUDA version, so a committed engine is a file that works on
# exactly one machine and fails cryptically everywhere else - including on the Zotac it would look
# ready for. Rebuild on the target with tracking/stream/export_trt.py.
*.engine
*.engine.json
*.onnx

# pilot mask cache (re-creatable, large)
results/benchmark/pilot/masks/
