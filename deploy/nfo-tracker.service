# Person tracker as an unattended service. Headless by design - see the bottom of this file for
# the on-screen variant.
#
# INSTALL
#   pip install .                         # provides the `nfo-tracker` command; see PACKAGING below
#   sudo usermod -aG video $USER          # MANDATORY - see PERMISSIONS below
#   sudo cp deploy/nfo-tracker.service /etc/systemd/system/
#   sudo mkdir -p /etc/nfo-tracker && sudo cp deploy/nfo-tracker.env /etc/nfo-tracker/env
#   sudo editor /etc/nfo-tracker/env      # PYTHON, WORKDIR, CAMERA at minimum
#   sudo editor /etc/systemd/system/nfo-tracker.service   # User=, Group=, ExecStart= path
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nfo-tracker
#   journalctl -u nfo-tracker -f
#
# Log out and back in (or reboot) after usermod, or the new group is not in your session.
#
# PERMISSIONS - the trap that makes this fail while the terminal works.
# /dev/video* is root:video 0660 with an ACL. On a desktop, systemd-logind grants the ACTIVE
# SESSION user read/write via that ACL, which is why running it by hand works. Verified on the
# development machine: `getfacl /dev/video2` shows `user:akovi:rw-` while `id` shows akovi is NOT
# in the video group. A service has no session, so it gets no ACL entry and the open fails with
# permission denied. SupplementaryGroups=video below covers the service side, but the account
# must actually be in that group too - hence the usermod.
#
# WHY THE START LIMIT IS DISABLED.
# systemd's default StartLimitBurst=5 / StartLimitIntervalSec=10s makes it GIVE UP after five
# rapid restarts. For something that must run indefinitely that is exactly backwards: at boot the
# USB camera is often not enumerated yet, the first open fails by design (a mistyped device should
# fail loudly rather than retry forever), and five quick failures would permanently stop the unit.
# StartLimitIntervalSec=0 removes the limit; RestartSec=5 keeps the retry loop cheap.

[Unit]
Description=NFO person tracker (live camera)
Documentation=https://github.com/-/nfo-tracker
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=akovi
Group=akovi
SupplementaryGroups=video

EnvironmentFile=/etc/nfo-tracker/env
Environment=PYTHONUNBUFFERED=1
# No WorkingDirectory= is needed. `pip install .` puts a real `nfo-tracker` command on disk, so
# nothing depends on the current directory or on PYTHONPATH - verified by running the installed
# command from / with the repository nowhere in sight.
#
# The PROGRAM must still be a literal absolute path: systemd expands ${VAR} in ExecStart
# ARGUMENTS but not in the command name, and `systemd-analyze verify` reports exactly that.
# Point this at wherever pip put the script - `pip show -f nfo-tracker`, or `which nfo-tracker`
# with the environment active.
ExecStart=/home/akovi/miniconda3/envs/smuggle-yolo/bin/nfo-tracker \
    --camera ${CAMERA} \
    --cam-size ${CAM_SIZE} \
    --cam-fps ${CAM_FPS} \
    --scale ${SCALE} \
    --status-every ${STATUS_EVERY} \
    --no-display \
    $EXTRA_ARGS

Restart=always
RestartSec=5

# Backstop for the "runs indefinitely" requirement. Measured steady-state RSS: 186 MB on this
# exact command line (640x360 processing from a 1280x720 camera), and 354 MB in a 60000-frame
# soak at 960x540, where it stayed flat (353.0 -> 353.5 MB, increments shrinking to zero). Nearly
# all of it is the numpy/cv2/scipy imports plus the ring buffer. 1G leaves 3-5x headroom, so if
# something ever does leak systemd kills and restarts this instead of the kernel OOM-killing
# something else on the box.
MemoryMax=1G

# The tracker is ~2.5 ms/frame at 640x360 and single-threaded, so it should never saturate a
# core. This is a guard, not a limit it is expected to reach.
CPUQuota=150%

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
# NOT PrivateDevices=yes - that hides /dev/video* and the camera disappears.
# NOT ProtectHome=yes    - the interpreter lives under /home in this install.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nfo-tracker

[Install]
WantedBy=multi-user.target

# ---------------------------------------------------------------------------------------------
# ON-SCREEN VARIANT (kiosk). Drop --no-display and run it as a USER service, because a system
# service has no access to the graphical session:
#
#   mkdir -p ~/.config/systemd/user
#   cp deploy/nfo-tracker.service ~/.config/systemd/user/
#   # then, in that copy: delete User=/Group=/SupplementaryGroups=, [Install] WantedBy=default.target,
#   # remove --no-display, and add:  Environment=DISPLAY=:0
#   systemctl --user daemon-reload && systemctl --user enable --now nfo-tracker
#   sudo loginctl enable-linger $USER      # so it survives logout
#
# The video group is still required - a lingering user service has no active session either, so
# it gets no logind ACL.
#
# KNOWN REMAINING GAP. Restart=always covers crashes, and the app itself now reconnects on a
# failed read and forces a reconnect after 10s with no frames, so a dead or unplugged camera is
# recovered rather than fatal. What is NOT covered is the app wedging while still producing
# frames - a true watchdog needs sd_notify (WatchdogSec= plus a notify call in the loop), which
# would add a dependency. The status line in the journal is the manual substitute: if it stops
# advancing, the process is wedged.

# PACKAGING - why ExecStart is a single command rather than `python -m ...`.
# pyproject.toml declares a console script (nfo-tracker -> tracking.stream.live:main) and scopes
# the distribution to tracking* ONLY, because the repository root also holds config/, dataset/,
# eval/, network/ and utils/ - generic names that would install as top-level modules and shadow
# unrelated packages in the same environment. Dependencies are numpy, opencv-python and scipy
# alone: the tracking path imports nothing else, and installing the tracker must not drag in the
# U-Net training stack or torch. Use `pip install .` for a fixed deployment, or `pipx install .`
# to get an isolated environment plus the command on PATH in one step.
